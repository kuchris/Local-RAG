{
  "name": "local-rag-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "A personal desktop reading app for local PDF and EPUB question answering",
  "main": "desktop/main.cjs",
  "scripts": {
    "start": "npm run build:ui && electron .",
    "build:ui": "vite build --config frontend/vite.config.ts",
    "dev:ui": "vite --config frontend/vite.config.ts",
    "typecheck": "tsc -p frontend",
    "test": "tsc -p frontend && node --check desktop/main.cjs && node --check desktop/preload.cjs",
    "test:e2e": "node tests/e2e/smoke.cjs",
    "pack": "npm run build:ui && node scripts/package.cjs"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "clsx": "2.1.1",
    "dompurify": "3.4.16",
    "electron": "44.4.3",
    "katex": "0.18.9",
    "lucide-react": "1.48.0",
    "marked": "18.0.14",
    "playwright": "^1.58.0",
    "prettier": "^3.9.8",
    "radix-ui": "1.6.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
